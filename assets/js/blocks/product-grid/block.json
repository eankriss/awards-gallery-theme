{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "awards-gallery/product-grid",
  "title": "Awards Gallery Product Grid",
  "category": "design",
  "icon": "screenoptions",
  "description": "Bordered grid of product cards: image, kicker, title, description and a details link.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "linkText": {
      "type": "string",
      "default": "See Details"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "kicker": "",
          "title": "",
          "text": "",
          "url": "",
          "image": {
            "id": 0,
            "url": ""
          }
        }
      ]
    }
  }
}
