{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "awards-gallery/collection",
  "title": "Awards Gallery Collection",
  "category": "design",
  "icon": "grid-view",
  "description": "\"Our Collection\" intro + image cards with overlaid captions and a button.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Our Collection"
    },
    "heading": {
      "type": "string",
      "default": "Brilliance in Its"
    },
    "headingScript": {
      "type": "string",
      "default": "Distinguished Form"
    },
    "text": {
      "type": "string",
      "default": "Six premium award materials, all fully custom-made for every occasion."
    },
    "buttonText": {
      "type": "string",
      "default": "See Full Collection"
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": [
        {
          "kicker": "",
          "title": "",
          "url": "",
          "image": {
            "id": 0,
            "url": ""
          }
        }
      ]
    }
  }
}
