{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1440px"
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true
    },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#0A0908" },
        { "slug": "ink-800", "name": "Ink 800", "color": "#141210" },
        { "slug": "gold", "name": "Gold", "color": "#DA9328" },
        { "slug": "gold-dark", "name": "Gold Dark", "color": "#9A6B2F" },
        { "slug": "cream", "name": "Cream", "color": "#F5F0E8" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#0A0908",
      "text": "#F5F0E8"
    },
    "typography": {
      "fontFamily": "Rubik, ui-sans-serif, system-ui, sans-serif",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0"
    }
  }
}
