{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "awards-gallery/page-hero",
  "title": "Awards Gallery Page Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Short hero for subpages: eyebrow, two-line script title and intro text over a background image.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Our Story"
    },
    "heading": {
      "type": "string",
      "default": "We are not just Award Makers"
    },
    "headingScript": {
      "type": "string",
      "default": "We Award Artist"
    },
    "text": {
      "type": "string",
      "default": "Three generations of Filipino craftsmanship. Over 70 years of honoring what matters most."
    },
    "image": {
      "type": "object",
      "default": {
        "id": 0,
        "url": ""
      }
    },
    "imageUrl": {
      "type": "string",
      "default": "page-hero-bg.jpg"
    }
  }
}
