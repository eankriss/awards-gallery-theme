{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "awards-gallery/collection",
  "title": "Awards Gallery Collection",
  "category": "design",
  "icon": "grid-view",
  "description": "\"Our Collection\" intro + image cards with overlaid captions and a button.",
