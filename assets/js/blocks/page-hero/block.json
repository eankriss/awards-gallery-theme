{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "awards-gallery/page-hero",
  "title": "Awards Gallery Page Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Short hero for subpages: eyebrow, two-line script title and intro text over an image, video or slideshow background.",
  "editorScript": "file:./build/index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Our Story"
    },
    "heading": {
      "type": "string",
      "default": "We are not just Award Makers"
    },
    "headingScript": {
      "type": "string",
      "default": "We Award Artist"
    },
    "text": {
      "type": "string",
      "default": "Three generations of Filipino craftsmanship. Over 70 years of honoring what matters most."
    },
    "image": {
      "type": "object",
      "default": {
        "id": 0,
        "url": ""
      }
    },
    "imageUrl": {
      "type": "string",
      "default": "page-hero-bg.jpg"
    },
    "bgType": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "slideshow"
      ],
      "default": "image"
    },
    "video": {
      "type": "object",
      "default": {
        "id": 0,
        "url": ""
      }
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "poster": {
      "type": "object",
      "default": {
        "id": 0,
        "url": ""
      }
    },
    "soundToggle": {
      "type": "boolean",
      "default": false
    },
    "slides": {
      "type": "array",
      "default": []
    },
    "slideInterval": {
      "type": "number",
      "default": 6
    },
    "slideEffect": {
      "type": "string",
      "enum": [
        "fade",
        "slide",
        "slide-up",
        "zoom",
        "blur",
        "cut"
      ],
      "default": "fade"
    },
    "slideSpeed": {
      "type": "number",
      "default": 1.5
    },
    "slideZoom": {
      "type": "boolean",
      "default": true
    }
  }
}
